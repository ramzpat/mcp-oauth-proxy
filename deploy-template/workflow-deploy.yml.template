# TEMPLATE -- copy to .github/workflows/deploy-<mcp-name>.yml on `main`
# (NOT on the deploy/<mcp-name> branch -- see the gotcha below) and fill in
# every TODO. See deploy-template/README.md for full setup instructions.
#
# This is the other half of a two-workflow pair, paired with
# workflow-build.yml.template on the deploy/<mcp-name> branch. It fires
# via `workflow_run` when that build workflow finishes, downloads the
# image digest it uploaded as an artifact, and deploys it to Cloud Run.
#
# Why this file has to live on `main`: GitHub only fires `workflow_run`
# for a listener workflow that exists on the repo's *default* branch,
# regardless of which branch the triggering workflow ran on. `main` still
# never builds anything or holds any MCP's config -- this file carries no
# vars/secrets of its own, just trigger plumbing and the gcloud
# invocation; everything MCP-specific still comes from the GitHub
# Environment referenced below, same as the build workflow.
#
# Gotcha: this job *runs* in main's branch context (that's the branch this
# workflow is defined on), even though it only fires because of pushes to
# deploy/<mcp-name>. If the Environment below has a "Deployment branches"
# restriction, it must allow `main` -- restricting it to deploy/<mcp-name>
# only will make every deploy hang waiting for an approval that can't be
# granted, or fail outright.

name: deploy <MCP_NAME> # TODO

on:
  workflow_run:
    workflows: ["build <MCP_NAME>"] # TODO: must match the `name:` in workflow-build.yml.template exactly
    types: [completed]

permissions:
  contents: read
  id-token: write # Workload Identity Federation
  actions: read # to download the build workflow's artifact

jobs:
  deploy:
    if: >
      github.event.workflow_run.head_branch == 'deploy/<MCP_NAME>' &&
      github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    environment: <MCP_NAME> # TODO: same GitHub Environment as the build workflow
    env:
      PROJECT_ID: ${{ vars.PROJECT_ID }}
      REGION: ${{ vars.REGION }}
      SERVICE: ${{ vars.SERVICE }}
    steps:
      - name: download built image digest
        uses: actions/download-artifact@v4
        with:
          name: image-digest
          run-id: ${{ github.event.workflow_run.id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.DEPLOYER_SERVICE_ACCOUNT }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: deploy to Cloud Run
        env:
          ALLOWED_DOMAINS: ${{ vars.ALLOWED_DOMAINS }}
          SIGNING_KEY: ${{ secrets.SIGNING_KEY }}
          GOOGLE_CLIENT_ID: ${{ secrets.GOOGLE_CLIENT_ID }}
          GOOGLE_CLIENT_SECRET: ${{ secrets.GOOGLE_CLIENT_SECRET }}
          # TODO: add one env entry per backend credential, e.g.:
          # BACKEND_TOKEN: ${{ secrets.BACKEND_TOKEN }}
        run: |
          set -euo pipefail
          PROXY_IMAGE=$(cat image-digest.txt)

          # `^##^` switches gcloud's list delimiter from "," to "##" so
          # secret values containing commas can't break --set-env-vars.
          deploy() {
            local public_url="$1"
            gcloud run deploy "$SERVICE" \
              --project="$PROJECT_ID" \
              --region="$REGION" \
              --allow-unauthenticated \
              --min-instances=0 --max-instances=3 \
              --no-cpu-throttling \
              --container=backend \
                --image=<BACKEND_IMAGE> \
                --command=<BACKEND_COMMAND> `# TODO: comma-separated argv, e.g. -t,streamable-http` \
                --set-env-vars="^##^PORT=<BACKEND_PORT>##HOST=127.0.0.1" `# TODO: add this MCP server's own env vars` \
              --container=oauth-proxy \
                --image="$PROXY_IMAGE" \
                --port=8080 \
                --startup-cpu-boost \
                --depends-on=backend \
                --set-env-vars="^##^PUBLIC_URL=${public_url}##UPSTREAM_URL=http://127.0.0.1:<BACKEND_PORT>##RESOURCE=${public_url}/mcp##ALLOWED_DOMAINS=${ALLOWED_DOMAINS}##SIGNING_KEY=${SIGNING_KEY}##GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}##GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}"
          }

          # Public URL is unknown until Cloud Run provisions the service for
          # the first time -- see deploy-template/README.md step 5.
          EXISTING_URL=$(gcloud run services describe "$SERVICE" \
            --project="$PROJECT_ID" --region="$REGION" \
            --format='value(status.url)' 2>/dev/null || true)

          if [ -n "$EXISTING_URL" ]; then
            echo "== Redeploying existing service (PUBLIC_URL=${EXISTING_URL}) =="
            deploy "$EXISTING_URL"
            SERVICE_URL="$EXISTING_URL"
          else
            echo "== First deploy: PUBLIC_URL isn't known yet -- bootstrapping =="
            echo "== Phase 1/2: provisioning with a placeholder URL =="
            deploy "https://placeholder.invalid"

            SERVICE_URL=$(gcloud run services describe "$SERVICE" \
              --project="$PROJECT_ID" --region="$REGION" \
              --format='value(status.url)')

            echo "== Phase 2/2: redeploying with the real PUBLIC_URL=${SERVICE_URL} =="
            deploy "$SERVICE_URL"

            echo
            echo "New service -- register this redirect URI in your IdP console"
            echo "before trying to log in (it wasn't knowable before this deploy):"
            echo "  ${SERVICE_URL}/oauth2/callback"
          fi

          echo
          echo "MCP endpoint: ${SERVICE_URL}/mcp"
