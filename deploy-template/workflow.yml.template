# TEMPLATE -- copy to .github/workflows/deploy.yml on a dedicated
# deploy/<mcp-name> branch and fill in every TODO. See deploy-template/README.md
# for full setup instructions (GAR + WIF prerequisites, GitHub Environment).
#
# Design baked into this template:
#  - Deploys only from this one branch, not main -- each MCP server gets its
#    own branch + workflow + GitHub Environment, so unrelated MCP
#    deployments never trigger each other's CI.
#  - Two jobs: `build` builds+pushes the oauth-proxy image (needs only the
#    GitHub Environment's non-secret vars, to tag/push it to GAR), then
#    `deploy` (needs: build) takes that image and rolls it out to Cloud Run
#    (needs the Environment's secrets too, for the container's env vars).
#    Keeping them separate means a build failure never touches the live
#    Cloud Run revision, and the built image is identified by digest so the
#    deploy step is guaranteed to run exactly what was just built and
#    pushed -- not a same-tag image that could've been overwritten in
#    between jobs.
#  - All config comes from a GitHub Environment named after the branch/
#    service: non-secret values as Environment variables, credentials as
#    Environment secrets. No Google Secret Manager -- keeps every MCP's
#    setup self-contained to GitHub. (Trade-off: secret values become
#    visible as plain env vars on the Cloud Run revision to anyone with
#    read access to the service in the GCP console. Swap the relevant
#    --set-env-vars entries below for --set-secrets=KEY=name:latest if a
#    given credential needs Secret Manager instead.)
#  - PUBLIC_URL/RESOURCE aren't known until Cloud Run assigns the service
#    its *.run.app URL. The very first deploy of a new service bootstraps
#    in two phases (deploy with a placeholder URL to provision the service,
#    then redeploy with the real one); every deploy after that reuses the
#    already-assigned URL in a single shot.

name: deploy <MCP_NAME> # TODO

on:
  push:
    branches: [deploy/<MCP_NAME>] # TODO: this branch only
  workflow_dispatch:

permissions:
  contents: read
  id-token: write # Workload Identity Federation

jobs:
  build:
    runs-on: ubuntu-latest
    environment: <MCP_NAME> # TODO: GitHub Environment holding the vars/secrets below
    outputs:
      image: ${{ steps.build.outputs.image }}
    env:
      PROJECT_ID: ${{ vars.PROJECT_ID }}
      REGION: ${{ vars.REGION }}
      AR_REPO: ${{ vars.AR_REPO }}
    steps:
      - uses: actions/checkout@v4

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.DEPLOYER_SERVICE_ACCOUNT }}

      - uses: google-github-actions/setup-gcloud@v2

      - run: gcloud auth configure-docker "${REGION}-docker.pkg.dev"

      - id: build
        name: build+push oauth-proxy image
        run: |
          set -euo pipefail
          IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/oauth-proxy:${{ github.sha }}"
          docker build -t "$IMAGE" .
          docker push "$IMAGE"

          # Pin the deploy job to the exact digest just pushed, not the tag
          # -- the tag could in principle be overwritten between jobs.
          DIGEST=$(docker inspect --format='{{index .RepoDigests 0}}' "$IMAGE")
          echo "image=$DIGEST" >> "$GITHUB_OUTPUT"

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment: <MCP_NAME> # TODO: same GitHub Environment as the build job
    env:
      PROJECT_ID: ${{ vars.PROJECT_ID }}
      REGION: ${{ vars.REGION }}
      SERVICE: ${{ vars.SERVICE }}
    steps:
      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.DEPLOYER_SERVICE_ACCOUNT }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: deploy to Cloud Run
        env:
          PROXY_IMAGE: ${{ needs.build.outputs.image }}
          ALLOWED_DOMAINS: ${{ vars.ALLOWED_DOMAINS }}
          SIGNING_KEY: ${{ secrets.SIGNING_KEY }}
          GOOGLE_CLIENT_ID: ${{ secrets.GOOGLE_CLIENT_ID }}
          GOOGLE_CLIENT_SECRET: ${{ secrets.GOOGLE_CLIENT_SECRET }}
          # TODO: add one env entry per backend credential, e.g.:
          # BACKEND_TOKEN: ${{ secrets.BACKEND_TOKEN }}
        run: |
          set -euo pipefail

          # `^##^` switches gcloud's list delimiter from "," to "##" so
          # secret values containing commas can't break --set-env-vars.
          deploy() {
            local public_url="$1"
            gcloud run deploy "$SERVICE" \
              --project="$PROJECT_ID" \
              --region="$REGION" \
              --allow-unauthenticated \
              --min-instances=0 --max-instances=3 \
              --no-cpu-throttling \
              --container=backend \
                --image=<BACKEND_IMAGE> \
                --command=<BACKEND_COMMAND> `# TODO: comma-separated argv, e.g. -t,streamable-http` \
                --set-env-vars="^##^PORT=<BACKEND_PORT>##HOST=127.0.0.1" `# TODO: add this MCP server's own env vars` \
              --container=oauth-proxy \
                --image="$PROXY_IMAGE" \
                --port=8080 \
                --startup-cpu-boost \
                --depends-on=backend \
                --set-env-vars="^##^PUBLIC_URL=${public_url}##UPSTREAM_URL=http://127.0.0.1:<BACKEND_PORT>##RESOURCE=${public_url}/mcp##ALLOWED_DOMAINS=${ALLOWED_DOMAINS}##SIGNING_KEY=${SIGNING_KEY}##GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}##GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}"
          }

          # Public URL is unknown until Cloud Run provisions the service for
          # the first time -- see deploy-template/README.md step 5.
          EXISTING_URL=$(gcloud run services describe "$SERVICE" \
            --project="$PROJECT_ID" --region="$REGION" \
            --format='value(status.url)' 2>/dev/null || true)

          if [ -n "$EXISTING_URL" ]; then
            echo "== Redeploying existing service (PUBLIC_URL=${EXISTING_URL}) =="
            deploy "$EXISTING_URL"
            SERVICE_URL="$EXISTING_URL"
          else
            echo "== First deploy: PUBLIC_URL isn't known yet -- bootstrapping =="
            echo "== Phase 1/2: provisioning with a placeholder URL =="
            deploy "https://placeholder.invalid"

            SERVICE_URL=$(gcloud run services describe "$SERVICE" \
              --project="$PROJECT_ID" --region="$REGION" \
              --format='value(status.url)')

            echo "== Phase 2/2: redeploying with the real PUBLIC_URL=${SERVICE_URL} =="
            deploy "$SERVICE_URL"

            echo
            echo "New service -- register this redirect URI in your IdP console"
            echo "before trying to log in (it wasn't knowable before this deploy):"
            echo "  ${SERVICE_URL}/oauth2/callback"
          fi

          echo
          echo "MCP endpoint: ${SERVICE_URL}/mcp"
